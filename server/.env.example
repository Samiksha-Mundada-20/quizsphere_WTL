# Copy this file to ".env" and fill in your own values.
PORT=5000

# MySQL connection (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=quiz_system

# Generate a unique secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Address of the React front end (needed for CORS)
CLIENT_URL=http://localhost:5173
