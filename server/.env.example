# Copy this file to ".env" and fill in your own values.
PORT=5000

# MySQL connection (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=quiz_system

# Secret key used to sign login tokens. Use any long random text.
JWT_SECRET=change_this_to_a_long_random_text

# Address of the React front end (needed for CORS)
CLIENT_URL=http://localhost:5173
